NODE_ENV=production

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_postgres_password
POSTGRES_DB=email_verifier
DATABASE_URL=postgresql://postgres:change_this_postgres_password@postgres:5432/email_verifier
