NODE_ENV=production
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/email_verifier
REDIS_URL=redis://redis:6379

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisStrongPassword

JWT_SECRET=change_this_secret_at_least_24_chars
COOKIE_SECRET=change_this_cookie_secret_24

REACHER_BASE_URL=https://verify.example.com/v1
REACHER_API_KEY=

REACHER_WORKER_MODE_ENABLED=true
REACHER_RABBITMQ_URL=amqp://rabbitmq:5672

BULK_CONCURRENCY=3
REACHER_REQUESTS_PER_SECOND=1
REACHER_TIMEOUT_MS=60000
VERIFICATION_CACHE_DAYS=7
MAX_UPLOAD_MB=25

FRONTEND_URL=https://app.example.com
API_PORT=4000
APP_DOMAIN=app.example.com

REACHER_API_IMAGE=reacherhq/backend:latest
REACHER_WORKER_IMAGE=reacherhq/backend:latest

