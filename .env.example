NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/email_verifier
REDIS_URL=redis://localhost:6379

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisStrongPassword

JWT_SECRET=change_this_secret_at_least_24_chars
COOKIE_SECRET=change_this_cookie_secret_24

REACHER_BASE_URL=https://verify.example.com/v1
REACHER_API_KEY=

REACHER_BULK_POLL_INTERVAL_MS=4000
REACHER_BULK_RESULTS_PAGE_SIZE=500
REACHER_TIMEOUT_MS=15000
VERIFICATION_CACHE_DAYS=7
MAX_UPLOAD_MB=20

FRONTEND_URL=http://localhost:5173
API_PORT=4000
APP_DOMAIN=app.example.com
